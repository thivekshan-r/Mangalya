# Copy this file to ".env.local" and fill in your own values.
# Never commit the real ".env.local" file.

# Address of the Express API.
# Leave this line commented out to show the sample catalogue (no API or database needed).
# On your computer: http://localhost:4000
# On the live site: the address your API host gives you, for example https://mangalya-api.onrender.com
# API_URL=http://localhost:4000

# The shop's WhatsApp number, used only with the sample catalogue so you can try
# the order buttons. International format, digits only. With the API connected,
# the number comes from the shop settings instead.
# WHATSAPP_NUMBER=9477XXXXXXX

# The website's own address, used in shared links and WhatsApp messages.
# On Vercel this is worked out automatically; set it if you use a custom domain.
# SITE_URL=https://www.example.lk
