# Copy this file to ".env" and fill in your own values.
# Never commit the real ".env" file.

# "development" on your computer, "production" on the live server
NODE_ENV=development

# Port the API listens on
PORT=4000

# MongoDB connection string from MongoDB Atlas (Connect > Drivers).
# Optional in development: without it the API runs with no database.
# Remove the "#" at the start of the next line once you have your own connection string.
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mangalya

# Address of the Next.js site that is allowed to call this API.
# Several addresses can be separated with commas.
WEB_ORIGIN=http://localhost:3000

# ---- Login ----
# Secret used to sign login cookies. Required on the live server (32+ characters).
# Make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development you can leave it out; logins then reset each time the API restarts.
# JWT_SECRET=

# How many days a login lasts
SESSION_DAYS=7

# ---- First owner account (used once by "npm run seed") ----
# Choose your own email and a password of at least 10 characters,
# run the seed, then remove the password line from this file.
SEED_OWNER_NAME=
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# ---- Image uploads (Cloudinary) ----
# From your Cloudinary dashboard. Uploads are switched off until all three are set.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
